# KTP HLTV API Watchdog - Restarts API if unresponsive
# Checks every 5 minutes, 5 second timeout on health check
*/5 * * * * root curl -sf --max-time 5 http://localhost:8087/health > /dev/null 2>&1 || (systemctl restart hltv-api && echo "$(date) - HLTV API restarted by watchdog" >> /var/log/hltv-api-watchdog.log)
