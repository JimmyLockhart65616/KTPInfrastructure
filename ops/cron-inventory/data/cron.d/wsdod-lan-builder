# WSDoD LAN 2026 — page builder
#
# Fetches the published-CSV registration sheet every 10 minutes, renders
# the dossier template at /opt/wsdod-lan-2026/index.html, writes the rendered
# output to /var/www/lan/index.html (served by nginx at /lan/).
#
# Manual overrides for team renames live at
# /opt/wsdod-lan-2026/team_overrides.json; the builder emits a WARN to stderr
# when override keys no longer match the CSV (signal to clean up).
#
# Source: KTPInfrastructure/wsdod-lan-2026/
# Owner: WSDoD Tournament Staff

SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

*/10 * * * * root cd /opt/wsdod-lan-2026 && /usr/bin/python3 builder.py --output /var/www/lan/index.html >> /var/log/wsdod-lan-builder.log 2>&1
